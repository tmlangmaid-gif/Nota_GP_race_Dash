# Copy this file to .env on the VPS (next to docker-compose.prod.yml) and fill it in.
# Never commit the real .env (it contains secrets).

# Strong random password for the Postgres user. Generate one with:
#   openssl rand -base64 24
POSTGRES_PASSWORD=replace-me-with-a-long-random-string

# Hostname Traefik will route to this backend. Must DNS to this VPS's IP.
# Examples:
#   racedash.example.com         (your own domain — add an A record to the VPS IP)
#   racedash.srv1595222.hstgr.cloud   (only if Hostinger gives you a wildcard for this)
RACEDASH_HOST=racedash.example.com

# Comma-separated list of frontend origins allowed to call this API.
# Wildcard "*" works for testing but tighten to your Vercel URL once it exists.
ALLOWED_ORIGINS=*

# Resend (https://resend.com) — used to send password-reset emails.
# Without these set, the backend logs the reset link to its container logs
# instead of emailing it.
RESEND_API_KEY=
# "From:" address. Must be on a domain you've verified in Resend, e.g.
# "Race Dash <noreply@yourdomain.com>". For testing without a verified domain
# you can use "onboarding@resend.dev" (only delivers to your own Resend email).
RESEND_FROM_EMAIL=

# Public base URL of the frontend, used to build links inside emails.
FRONTEND_BASE_URL=https://nota-gp-race-dash.vercel.app
