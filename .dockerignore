# Keep the Docker build context tight — only ship what the image actually needs.
.git/
.gitignore
.vscode/
.idea/
.scratch/
.venv/
venv/
env/

# Local DB / scratch files (not needed in the deployed image; production uses Postgres).
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python build artefacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Node-ish (if anyone ever adds a build step)
node_modules/

# Frontend deploy config — Fly doesn't need it (Vercel reads it directly from the repo).
frontend/vercel.json

# Misc
.DS_Store
*.log
